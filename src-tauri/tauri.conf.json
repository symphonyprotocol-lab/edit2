{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "edit2",
  "version": "0.1.0",
  "identifier": "dev.symphonyprotocollab.edit2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline' asset: http://asset.localhost; font-src 'self' data: asset: http://asset.localhost; frame-src preview: http://preview.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "轻量文本与数据文件编辑器",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "name": "Markdown Document",
        "description": "Markdown 文档",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt", "text", "log"],
        "name": "Plain Text",
        "description": "纯文本",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": ["json", "jsonc", "json5", "geojson", "webmanifest"],
        "name": "JSON Document",
        "description": "JSON 文件",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/json"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "YAML Document",
        "description": "YAML 文件",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/yaml"
      },
      {
        "ext": ["toml"],
        "name": "TOML Document",
        "description": "TOML 文件",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/toml"
      },
      {
        "ext": ["xml", "svg", "plist", "xsd", "xsl", "xslt", "rss", "atom"],
        "name": "XML Document",
        "description": "XML 文件",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/xml"
      },
      {
        "ext": ["csv", "tsv", "tab"],
        "name": "CSV Document",
        "description": "CSV 表格",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/csv"
      },
      {
        "ext": ["html", "htm"],
        "name": "HTML Document",
        "description": "HTML 网页",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/html"
      }
    ]
  }
}
